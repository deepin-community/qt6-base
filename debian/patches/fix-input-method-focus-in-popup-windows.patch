+void tst_QGuiApplication::popupFocusObject()
+{
+    int argc = 0;
+    QGuiApplication app(argc, nullptr);
+
+    if (!QGuiApplicationPrivate::platformIntegration()->hasCapability(QPlatformIntegration::WindowActivation))
+        QSKIP("QWindow::requestActivate() is not supported.");
+
+    InputMethodObject mainInput, popupInput, nestedInput;
+    QObject nonInput;
+    DummyWindow window;
+    window.setPosition(100, 100);
+    window.setFocusObject(&mainInput);
+    window.show();
+    window.requestActivate();
+    QVERIFY(QTest::qWaitForWindowActive(&window));
+    QCOMPARE(app.focusObject(), &mainInput);
+
+    DummyWindow popup;
+    popup.setPosition(350, 250);
+    popup.setFlags(Qt::Popup | Qt::WindowDoesNotAcceptFocus);
+    popup.setTransientParent(&window);
+    popup.setFocusObject(&popupInput);
+    popup.show();
+    QCOMPARE(app.focusWindow(), &window);
+    QCOMPARE(app.focusObject(), &popupInput);
+    QTransform popupInputTransform;
+    popupInputTransform.translate(10, 20);
+    popupInputTransform.scale(2, 3);
+    app.inputMethod()->setInputItemTransform(popupInputTransform);
+    QCOMPARE(app.inputMethod()->inputItemTransform(), popupInputTransform);
+    const auto expectedCursorRectangle = [&] {
+        const QRectF popupCursorRectangle = popupInputTransform.mapRect(popupInput.cursorRectangle);
+        return QRectF(window.mapFromGlobal(popup.mapToGlobal(popupCursorRectangle.topLeft())),
+                      popupCursorRectangle.size());
+    };
+    QCOMPARE(app.inputMethod()->cursorRectangle(), expectedCursorRectangle());
+
+    popup.setPosition(400, 300);
+    QCOMPARE(app.inputMethod()->cursorRectangle(), expectedCursorRectangle());
+
+    popup.setFocusObject(&nonInput);
+    QCOMPARE(app.focusObject(), &mainInput);
+    popup.setFocusObject(&popupInput);
+    QCOMPARE(app.focusObject(), &popupInput);
+
+    DummyWindow nestedPopup;
+    nestedPopup.setFlags(Qt::Popup | Qt::WindowDoesNotAcceptFocus);
+    nestedPopup.setTransientParent(&popup);
+    nestedPopup.setFocusObject(&nestedInput);
+    nestedPopup.show();
+    QCOMPARE(app.focusObject(), &nestedInput);
+    nestedPopup.setFocusObject(&nonInput);
+    QCOMPARE(app.focusObject(), &popupInput);
+    nestedPopup.setFocusObject(&nestedInput);
+    QCOMPARE(app.focusObject(), &nestedInput);
+
+    nestedPopup.hide();
+    QCOMPARE(app.focusObject(), &popupInput);
+    popup.hide();
+    QCOMPARE(app.focusObject(), &mainInput);
+}
