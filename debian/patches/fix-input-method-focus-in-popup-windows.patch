+// Platform input contexts expect geometry relative to the native focus window.
+// Translate from a non-activating popup's coordinate system when necessary.
+QTransform QInputMethodPrivate::inputItemTransformToFocusWindow() const
+{
+    QWindow *focusWindow = QGuiApplication::focusWindow();
+    QWindow *inputWindow = QGuiApplicationPrivate::inputMethodFocusWindow();
+    if (!focusWindow || !inputWindow || inputWindow == focusWindow)
+        return inputItemTransform;
+
+    const QPointF inputWindowOrigin =
+            focusWindow->mapFromGlobal(inputWindow->mapToGlobal(QPointF()));
+    return inputItemTransform
+            * QTransform::fromTranslate(inputWindowOrigin.x(), inputWindowOrigin.y());
+}
