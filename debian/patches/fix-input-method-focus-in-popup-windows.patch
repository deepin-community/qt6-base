+class InputMethodObject : public QObject
+{
+public:
+    QRectF cursorRectangle = QRectF(4, 5, 1, 10);
+
+protected:
+    bool event(QEvent *event) override
+    {
+        if (event->type() == QEvent::InputMethodQuery) {
+            auto *queryEvent = static_cast<QInputMethodQueryEvent *>(event);
+            if (queryEvent->queries().testFlag(Qt::ImEnabled))
+                queryEvent->setValue(Qt::ImEnabled, true);
+            if (queryEvent->queries().testFlag(Qt::ImCursorRectangle))
+                queryEvent->setValue(Qt::ImCursorRectangle, cursorRectangle);
+        }
+        return QObject::event(event);
+    }
+};
